# ─────────────────────────────────────────────────────────────
# Manifest — variables de entorno
# Sin ninguna de estas, la app funciona en MODO MOCK (demo completa,
# coste 0, imagenes/voz sinteticas generadas localmente).
# ─────────────────────────────────────────────────────────────

# Proveedor por defecto para cada etapa: mock | fal | kling | elevenlabs | openai | anthropic
SCRIPT_PROVIDER=mock
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
VOICE_PROVIDER=mock

# --- Guion (LLM) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Imagen (identidad preservada a partir del selfie) ---
# fal.ai cubre flux-kontext / nano-banana / instantid con una sola key
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/bytedance/seedream/v4.5/edit

# --- Video animado (image-to-video) ---
FAL_VIDEO_MODEL=minimax/h3-max/image-to-video
# Nivel Elevado ($49): Kling 3.0 Pro vía fal.
FAL_VIDEO_MODEL_ELEVATED=fal-ai/kling-video/v3/pro/image-to-video
# Voz y guion vía fal (opcionales: estos son los valores por defecto)
FAL_TTS_VOICE=Sarah
FAL_LLM_MODEL=anthropic/claude-sonnet-4.6
# Beta privada: crear vídeos exige entrar por /api/access?code=<ACCESS_CODE>
ACCESS_CODE=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# --- Voz ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ES=EXAVITQu4vr4xnSDxMaL

# --- Ensamblado a MP4 (opcional) ---
# La imagen de Docker trae ffmpeg, asi que en el contenedor esto ya funciona.
# En local, si no tienes el binario, la app sigue funcionando: el video se ve
# en el reproductor web y solo se deshabilita la descarga.
FFMPEG_PATH=ffmpeg

# --- App ---
# Dónde escribe la app: base de datos JSON, selfies y escenas generadas.
# En local, .data/ del proyecto. En el contenedor, el volumen montado en /data.
DATA_DIR=.data

# --- Web pública ---
# URL pública (para enlaces de pago e imágenes al compartir). Por defecto, el dominio de Railway.
SITE_URL=
# Correo de contacto que sale en el pie y en las páginas legales.
CONTACT_EMAIL=
# Nombre legal del responsable (persona o empresa) para las páginas legales.
LEGAL_NAME=

# --- Pagos (Stripe Checkout) ---
# Con PAYMENTS_ENABLED=true y las dos claves, después del vídeo gratis se cobra en Stripe.
PAYMENTS_ENABLED=false
# Sin pagos, solo estos emails (separados por comas) pueden generar; el resto ve "muy pronto".
PRELAUNCH_ALLOWLIST=
STRIPE_SECRET_KEY=
# Webhook: https://<tu-dominio>/api/stripe/webhook, evento checkout.session.completed
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Vídeos gratis por persona antes de cobrar.
FREE_VIDEOS=0

# --- Almacenamiento ---
# Días que se guardan las fotos subidas (las de otras personas se borran al terminar el vídeo).
UPLOAD_TTL_DAYS=30
# Si se fija, los vídeos se borran solos pasados estos días. Vacío = se guardan hasta que el usuario los borre.
VIDEO_TTL_DAYS=

# --- Cuentas (Supabase Auth + base de datos) ---
# Sin estas variables la app usa ficheros JSON y visitantes anónimos (desarrollo).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_...): solo en el servidor, nunca en el navegador.
SUPABASE_SECRET_KEY=

# --- Email "tu vídeo está listo" (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Cola ---
# Vídeos que se generan a la vez (cada montaje usa ~5 min de CPU).
PIPELINE_CONCURRENCY=2

# --- Bucket S3 para vídeos (Railway Buckets) ---
# En Railway se rellenan con referencias: ${{manifest-media.ENDPOINT}}, etc.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Moderación del lenguaje (deseos, títulos, perfil). Sin OPENAI_API_KEY se usa
# el LLM de fal como clasificador (~0,001 $ por comprobación).
# OPENAI_API_KEY=        # opcional: OpenAI Moderation (gratis)
# FAL_MODERATION_MODEL=  # opcional: modelo de OpenRouter para moderar (por defecto FAL_LLM_MODEL)
# PHOTO_NSFW_THRESHOLD=0.5  # opcional: umbral (0–1) del filtro de desnudos de las fotos subidas
