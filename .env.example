# ─────────────────────────────────────────────────────────────
# Manifest — variables de entorno
# Sin ninguna de estas, la app funciona en MODO MOCK (demo completa,
# coste 0, imagenes/voz sinteticas generadas localmente).
# ─────────────────────────────────────────────────────────────

# Proveedor por defecto para cada etapa: mock | fal | kling | elevenlabs | openai | anthropic
SCRIPT_PROVIDER=mock
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
VOICE_PROVIDER=mock

# --- Guion (LLM) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Imagen (identidad preservada a partir del selfie) ---
# fal.ai cubre flux-kontext / nano-banana / instantid con una sola key
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux-pro/kontext

# --- Video animado (image-to-video) ---
FAL_VIDEO_MODEL=fal-ai/kling-video/v2/standard/image-to-video
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# --- Voz ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ES=EXAVITQu4vr4xnSDxMaL

# --- Ensamblado a MP4 (opcional) ---
# Si no hay binario de ffmpeg, la app entrega el video en el reproductor web
# y marca la exportacion MP4 como pendiente.
FFMPEG_PATH=ffmpeg

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
